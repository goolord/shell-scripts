#!/usr/bin/env zsh
# gyazo-like screenshot using shutter on x, or grim on wayland

# set -e

NOW=$(date +'%m.%d.%Y.%R')
filename="/tmp/${NOW}.png"

function shot {
  # shutter -e -n -s -o "$filename" &>/dev/null
  # scrot -s "$filename" &>/dev/null
  # gnome-screenshot -a -f $filename &>/dev/null
  # flameshot config -f "%m.%d.%Y.%R" && flameshot gui -p /tmp/ &>/dev/null
  DIMS="$(slurp)"
  if [ -n "$DIMS" ];
  then
    grim -g "$DIMS" "$filename"
  else
    grim "$filename"
  fi
}

shot

ACTION=$(zenity --question --title 'Scroat: Image capture options' \
    --text 'Image captured' \
    --icon camera-photo \
    --extra-button Cancel \
    --extra-button Upload \
    --extra-button 'Copy to clipboard' \
    --extra-button Save \
    --switch \
    --width 200 \
    --height 100 \
  )

if [ -n "${ACTION}" ]; then
  case $ACTION in
    Save)
      NEW_FILE=$(zenity --file-selection --save --confirm-overwrite --filename="${HOME}/Pictures/${NOW}.png")
      if [ -n "$NEW_FILE" ]; then
        mv "$filename" "$NEW_FILE"
      else
        echo "save cancelled, screenshot kept at $filename" >&2
        exit 0
      fi
      ;;
    'Copy to clipboard')
      wl-copy -t image/png < "$filename"
      ;;
    Upload)
      if ! response=$(curl -sS --max-time 120 -F "image=@$filename" https://kinja-img.com/api/upload); then
        echo "upload failed: curl exited with status $?" >&2
      elif ! jq -e '.success == true' <<< "$response" &>/dev/null; then
        if error=$(jq -r '.error // empty' <<< "$response" 2>/dev/null) && [ -n "$error" ]; then
          echo "upload failed: $error" >&2
        else
          echo "upload failed: could not parse response" >&2
          echo "$response" >&2
        fi
      else
        url=$(jq -r '.direct // empty' <<< "$response")
        delete_url=$(jq -r '.delete_url // empty' <<< "$response")
        if [ -n "$url" ]; then
          [ -n "$delete_url" ] && echo "Delete page: $delete_url" >&2
          xdg-open "$url" &>/dev/null
        else
          echo "upload failed: missing direct URL in response" >&2
          echo "$response" >&2
        fi
      fi
      ;;
  esac
fi

rm -f "$filename"

exit 0
