#!/usr/bin/env zsh

trap "exit 1" INT;

function fzf_search () {
  RG_PREFIX="rg --column --line-number --no-heading --color=always --smart-case "
  FZF_DEFAULT_COMMAND="$RG_PREFIX ''" \
    fzf --bind "change:reload:$RG_PREFIX {q} || true" \
        --ansi --disabled \
        --height=50% --layout=reverse \
        --print-query
}

SEARCH_TXT="$(fzf_search | head -1)"

FILES=("${(@f)$(rg --smart-case -l "$SEARCH_TXT")}")

# escape sed delimiter in the pattern, and backrefs/delimiter in the replacement
SEARCH_ESC=$(printf '%s' "$SEARCH_TXT" | sed 's/[@\\]/\\&/g')
# the sed script below is single-quoted, so protect embedded single quotes
SEARCH_PREVIEW=${SEARCH_ESC//\'/\'\\\'\'}

function fzf_replace () {
  SED_PREFIX="sed -n -e 's@$SEARCH_PREVIEW@{q}@gp' ${(q)FILES[@]}"
  FZF_DEFAULT_COMMAND="$SED_PREFIX" \
    fzf --bind "change:reload:$SED_PREFIX || true" \
        --ansi --disabled \
        --height=50% --layout=reverse \
        --print-query
}

REPLACE_TXT=$(fzf_replace | head -1)
REPLACE_ESC=$(printf '%s' "$REPLACE_TXT" | sed 's/[@&\\]/\\&/g')

printf "Search: ${SEARCH_TXT}\n"
printf "Replace: ${REPLACE_TXT}\n"
printf "Files: %s\n" "${FILES[*]}"
echo
echo "Looks good?"
read -r confirm

case $confirm in
  'y')
    printf '%s\0' "${FILES[@]}" | xargs -0 -r sed -i.farbu -e "s@$SEARCH_ESC@$REPLACE_ESC@g"
    ;;
  'n')
    exit
    ;;
esac

LIGHT_RED='\033[1;31m'
NC='\033[0m' # No Color
printf "if all is well, you may run ${LIGHT_RED}\`fd .farbu -x rm\`${NC}\n"
