#!/bin/bash

# Check if an image file is provided
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <image-file>"
    exit 1
fi

FONT="Liberation-Sans-Bold"

# Get the input image file
input_image="$1"

# Extract the filename without the extension
filename=$(basename "$input_image")
filename_no_ext="${filename%.*}"

# Define the output image file
output_image="./withtext/${filename}"
mkdir -p ./withtext

font_size=48

text_width=$(magick -font "$FONT" -pointsize "$font_size" -gravity North -background none label:"$filename_no_ext" -format "%w" info:)
text_height=$(magick -font "$FONT" -pointsize "$font_size" -gravity North -background none label:"$filename_no_ext" -format "%h" info:)

min_width=$((text_width + 6))
min_height=$((text_height * 3))

# Use ImageMagick to add the filename to the image
magick "$input_image" \
    -resize "${min_width}x${min_height}<" \
    -gravity center \
    -extent "${min_width}x${min_height}<" \
    -gravity South \
    -background transparent \
    -transparent white \
    -font "$FONT" -pointsize "$font_size" \
    -stroke black -strokewidth 5 -fill none \
    -annotate +0+5 "$filename_no_ext" \
    -stroke none -fill white \
    -annotate +0+5 "$filename_no_ext" \
    "$output_image"

    # -fuzz 1% -trim \

echo "Added filename to image: $output_image"
